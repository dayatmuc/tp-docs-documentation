    (organization_id, local_file_id, created_at) [name: 'idx_document_generation_history']
    (status, created_at) [name: 'idx_document_generation_worker']
  }
}

Table document_generation_attempts {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  generation_id uuid [not null, ref: > document_generations.id]
  attempt_number int [not null]
  status document_generation_status [not null]
  safe_error_code varchar(80)
  started_at timestamptz [not null]
  completed_at timestamptz

  indexes {
    (generation_id, attempt_number) [unique, name: 'uq_document_generation_attempt']
    (organization_id, status, started_at) [name: 'idx_generation_attempts_status']
  }
}

Table document_snapshots {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  generation_id uuid [not null, unique, ref: > document_generations.id]
  local_file_id uuid [not null, ref: > local_files.id]
  schema_version varchar(40) [not null]
  snapshot_data jsonb [not null]
  checksum_sha256 varchar(64) [not null]
  created_at timestamptz [not null]

  indexes {
    (organization_id, local_file_id, created_at) [name: 'idx_document_snapshots_history']
  }
}

Table document_versions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  local_file_id uuid [not null, ref: > local_files.id]
  generation_id uuid [not null, unique, ref: > document_generations.id]
  version_number int [not null]
  docx_file_id uuid [not null, ref: > files.id]
  pdf_file_id uuid [ref: > files.id]
  template_version varchar(40) [not null]
  snapshot_checksum varchar(64) [not null]
  created_at timestamptz [not null]

  indexes {
    (local_file_id, version_number) [unique, name: 'uq_document_version_number']
    (local_file_id, version_number, id) [name: 'idx_document_versions_history_page']
    (organization_id, created_at) [name: 'idx_document_versions_org_created']
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  organization_id uuid [ref: > organizations.id]
  type varchar(80) [not null]
  title varchar(255) [not null]
  body text [not null]
  reference_type varchar(40)
  reference_id uuid
  read_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (user_id, read_at, created_at) [name: 'idx_notifications_user_unread']
  }
}

Table email_deliveries {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  user_id uuid [ref: > users.id]
  provider_message_id varchar(160) [unique]
  template_code varchar(80) [not null]
  recipient_hash varchar(128) [not null]
  status varchar(32) [not null]
  idempotency_key varchar(128) [not null, unique]
  attempt_count int [not null, default: 0]
  safe_error_code varchar(80)
  sent_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (status, created_at) [name: 'idx_email_delivery_retry']
  }
}

Table audit_logs {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  actor_user_id uuid [ref: > users.id]
  actor_type varchar(24) [not null]
  action varchar(120) [not null]
  target_type varchar(80) [not null]
  target_id uuid
  reason text
  ip_hash varchar(128)
  correlation_id varchar(80)
  metadata jsonb
  occurred_at timestamptz [not null]

  indexes {
    (organization_id, occurred_at) [name: 'idx_audit_org_time']
    (actor_user_id, occurred_at) [name: 'idx_audit_actor_time']
    (target_type, target_id, occurred_at) [name: 'idx_audit_target_time']
  }
}

Table platform_settings {
  key varchar(120) [pk]
  value jsonb [not null]
  updated_by_admin_id uuid [not null, ref: > users.id]
  updated_at timestamptz [not null]
}

Table maintenance_events {
  id uuid [pk]
  message text [not null]
  is_active boolean [not null, default: false]
  activated_by_admin_id uuid [ref: > users.id]
  deactivated_by_admin_id uuid [ref: > users.id]
  activated_at timestamptz
  deactivated_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (is_active, created_at) [name: 'idx_maintenance_active']
  }
}

Table integration_events {
  id uuid [pk]
  provider varchar(40) [not null]
  event_type varchar(80) [not null]
  external_event_id varchar(160)
  status varchar(32) [not null]
  payload_hash varchar(128)
  correlation_id varchar(80)
  safe_error_code varchar(80)
  received_at timestamptz [not null]
  processed_at timestamptz

  indexes {
    (provider, external_event_id) [unique, name: 'uq_integration_external_event']
    (status, received_at) [name: 'idx_integration_processing']
  }
}

Table idempotency_keys {
  id uuid [pk]
  scope varchar(80) [not null]
  key varchar(160) [not null]
  request_hash varchar(128) [not null]
  response_code int
  resource_type varchar(80)
  resource_id uuid
  expires_at timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (scope, key) [unique, name: 'uq_idempotency_scope_key']
    (expires_at) [name: 'idx_idempotency_expiry']
  }
}

Ref: subscriptions.activated_by_payment_id > payments.id
Ref: subscription_document_addons.payment_id > payments.id
Ref: subscription_seat_addons.payment_id > payments.id
Ref: refunds.evidence_file_id > files.id
