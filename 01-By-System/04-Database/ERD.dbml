Project tp_docs_by_system {
  database_type: 'PostgreSQL'
  Note: 'Logical ERD TP Docs By System. UUID dibuat aplikasi atau gen_random_uuid(). Semua tabel tenant wajib difilter menggunakan organization_id.'
}

Enum user_status {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

Enum membership_role {
  OWNER
  EMPLOYEE
}

Enum platform_role {
  ADMINISTRATOR
}

Enum membership_status {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

Enum invitation_status {
  PENDING
  USED
  REJECTED
  CANCELLED
  EXPIRED
}

Enum plan_code {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE_CUSTOM
}

Enum subscription_status {
  PENDING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  FROZEN
}

Enum payment_status {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

Enum payment_session_status {
  CREATED
  ACTIVE
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

Enum payment_dispute_status {
  ACTION_REQUIRED
  UNDER_REVIEW
  WON
  LOST
  ACCEPTED
  CLOSED
}

Enum payment_purpose {
  SUBSCRIPTION
  UPGRADE
  DOCUMENT_ADDON
  SEAT_ADDON
  CUSTOM_PLAN
}

Enum refund_status {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  REFUNDED
  FAILED
}

Enum custom_request_status {
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  QUOTED
  AWAITING_PAYMENT
  ACTIVE
  REJECTED
  CLOSED
}

Enum local_file_status {
  DRAFT
  IN_PROGRESS
  READY_TO_GENERATE
  GENERATING
  GENERATED
  ARCHIVED
}

Enum section_status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  NEEDS_REVISION
}

Enum transaction_scope {
  AFFILIATE
  INDEPENDENT
}

Enum ai_generation_status {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  ACCEPTED
}

Enum ai_phase_category {
  INPUT
  PROCESS
  CONTROL
  OUTPUT
}

Enum document_generation_status {
  QUEUED
  RENDERING_DOCX
  VALIDATING_DOCX
  CONVERTING_PDF
  VALIDATING_PDF
  SUCCEEDED
  FAILED
}

Enum transaction_import_status {
  UPLOADED
  VALIDATING
  VALID
  INVALID
  IMPORTING
  IMPORTED
  FAILED
}

Enum file_extraction_status {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
}

Enum file_scan_status {
  PENDING
  CLEAN
  INFECTED
  FAILED
  QUARANTINED
}

Enum file_content_status {
  UPLOADING
  COMPLETE
  CORRUPTED
  DELETED
}

Enum quota_type {
  DOCUMENT
  SEAT
}

Enum quota_event_type {
  GRANT
  CONSUME
  RELEASE
  ADJUSTMENT
  EXPIRE
}

Enum quotation_status {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

Table users {
  id uuid [pk]
  email varchar(320) [not null, unique]
  full_name varchar(200) [not null]
  phone varchar(40)
  status user_status [not null, default: 'PENDING_VERIFICATION']
  email_verified_at timestamptz
  locale varchar(10) [not null, default: 'id-ID']
  timezone varchar(64) [not null, default: 'Asia/Jakarta']
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    (status, created_at) [name: 'idx_users_status_created']
  }
}

Table user_passwords {
  user_id uuid [pk, ref: > users.id]
  password_hash text [not null]
  algorithm varchar(32) [not null]
  changed_at timestamptz [not null]
  must_change boolean [not null, default: false]
}

Table platform_user_roles {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  role platform_role [not null]
  granted_by_user_id uuid [ref: > users.id]
  granted_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    (user_id, role) [unique, name: 'uq_platform_user_role']
    (role, revoked_at) [name: 'idx_platform_roles_active']
  }
}

Table mfa_methods {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  method varchar(32) [not null]
  secret_ciphertext text
  is_primary boolean [not null, default: false]
  verified_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (user_id, revoked_at) [name: 'idx_mfa_user_active']
  }
}

Table user_sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  refresh_token_hash text [not null, unique]
  ip_hash varchar(128)
  user_agent_hash varchar(128)
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (user_id, revoked_at, expires_at) [name: 'idx_sessions_user_active']
    (expires_at) [name: 'idx_sessions_expiry']
  }
}

Table auth_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  purpose varchar(40) [not null]
  token_hash varchar(128) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (user_id, purpose, expires_at) [name: 'idx_auth_tokens_user_purpose']
  }
}

Table organizations {
  id uuid [pk]
  legal_name varchar(255) [not null]
  slug varchar(120) [not null, unique]
  status varchar(32) [not null, default: 'ACTIVE']
  created_by_user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    (status, created_at) [name: 'idx_organizations_status_created']
  }
}

Table organization_profiles {
  organization_id uuid [pk, ref: > organizations.id]
  npwp_ciphertext text
  business_field varchar(255)
  address text
  phone varchar(40)
  country_code char(2) [not null, default: 'ID']
  data_region varchar(64)
  updated_by_user_id uuid [ref: > users.id]
  updated_at timestamptz [not null]
}

Table memberships {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  user_id uuid [not null, ref: > users.id]
  role membership_role [not null]
  status membership_status [not null]
  joined_at timestamptz
  revoked_at timestamptz
  revoked_by_user_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, user_id) [unique, name: 'uq_membership_org_user']
    (organization_id, status, role) [name: 'idx_membership_org_status_role']
    (user_id, status) [name: 'idx_membership_user_status']
  }
}

Table invitations {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  email varchar(320) [not null]
  invited_user_id uuid [ref: > users.id]
  invited_by_user_id uuid [not null, ref: > users.id]
  token_hash varchar(128) [not null, unique]
  status invitation_status [not null, default: 'PENDING']
  expires_at timestamptz [not null]
  responded_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, status, created_at) [name: 'idx_invitations_org_status']
    (email, status) [name: 'idx_invitations_email_status']
  }
}

Table plans {
  id uuid [pk]
  code plan_code [not null, unique]
  name varchar(100) [not null]
  description text
  duration_months int
  included_documents int
  included_seats int
  allows_document_addon boolean [not null, default: false]
  allows_seat_addon boolean [not null, default: false]
  allows_pdf boolean [not null, default: false]
  is_custom boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table plan_prices {
  id uuid [pk]
  plan_id uuid [not null, ref: > plans.id]
  currency char(3) [not null, default: 'IDR']
  amount_minor bigint [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz
  created_at timestamptz [not null]

  indexes {
    (plan_id, currency, valid_from) [name: 'idx_plan_prices_lookup']
  }
}

Enum discount_kind {
  PERCENT
  FIXED_AMOUNT
}

Enum discount_campaign_status {
  DRAFT
  ACTIVE
  INACTIVE
}

Table discount_campaigns {
  id uuid [pk]
  name varchar(160) [not null]
  status discount_campaign_status [not null, default: 'DRAFT']
  kind discount_kind [not null]
  value numeric(20,2) [not null]
  currency char(3)
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  usage_limit int
  created_by_admin_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (status, starts_at, ends_at) [name: 'idx_discount_campaigns_active'] }
}

Table discount_campaign_targets {
  id uuid [pk]
  campaign_id uuid [not null, ref: > discount_campaigns.id]
  product_type varchar(40) [not null]
  product_id uuid
  indexes { (product_type, product_id) [name: 'idx_discount_target_lookup'] }
}

Table discount_redemptions {
  id uuid [pk]
  campaign_id uuid [not null, ref: > discount_campaigns.id]
  payment_id uuid [not null, unique, ref: > payments.id]
  organization_id uuid [not null, ref: > organizations.id]
  discount_amount_minor bigint [not null]
  redeemed_at timestamptz [not null]
  indexes { (campaign_id, redeemed_at) [name: 'idx_discount_redemptions_count'] }
}

Table subscriptions {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  plan_id uuid [not null, ref: > plans.id]
  status subscription_status [not null]
  start_at timestamptz
  end_at timestamptz
  document_quota int [not null, default: 0]
  seat_quota int [not null, default: 1]
  custom_terms jsonb
  activated_by_payment_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, status, end_at) [name: 'idx_subscriptions_org_status']
    (plan_id, status) [name: 'idx_subscriptions_plan_status']
  }
}

Table subscription_document_addons {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  subscription_id uuid [not null, ref: > subscriptions.id]
  payment_id uuid
  quantity int [not null]
  used_quantity int [not null, default: 0]
  unit_price_minor bigint [not null]
  valid_until timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (subscription_id, valid_until) [name: 'idx_document_addons_subscription']
  }
}

Table subscription_seat_addons {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  subscription_id uuid [not null, ref: > subscriptions.id]
  payment_id uuid
  quantity int [not null]
  prorated_amount_minor bigint [not null]
  valid_until timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (subscription_id, valid_until) [name: 'idx_seat_addons_subscription']
  }
}

Table quota_ledger {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  subscription_id uuid [not null, ref: > subscriptions.id]
  quota_type quota_type [not null]
  event_type quota_event_type [not null]
  quantity int [not null]
  reference_type varchar(40) [not null]
  reference_id uuid [not null]
  idempotency_key varchar(128) [not null, unique]
  occurred_at timestamptz [not null]
  created_by_user_id uuid [ref: > users.id]

  indexes {
    (organization_id, quota_type, occurred_at) [name: 'idx_quota_ledger_org_type']
    (subscription_id, quota_type, occurred_at) [name: 'idx_quota_ledger_subscription_type']
  }
}

Table payment_provider_customers {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  provider varchar(40) [not null, default: 'XENDIT']
  provider_customer_id varchar(160) [not null]
  reference_id varchar(160) [not null]
  customer_type varchar(24) [not null, default: 'BUSINESS']
  country char(2) [not null, default: 'ID']
  sync_status varchar(32) [not null]
  last_synced_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, provider) [unique, name: 'uq_provider_customer_org']
    (provider, provider_customer_id) [unique, name: 'uq_provider_customer_id']
    (provider, reference_id) [unique, name: 'uq_provider_customer_reference']
  }
}

Table payments {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  provider_customer_id uuid [ref: > payment_provider_customers.id]
  subscription_id uuid [ref: > subscriptions.id]
  initiated_by_user_id uuid [not null, ref: > users.id]
  purpose payment_purpose [not null]
  provider varchar(40) [not null]
  reference_id varchar(160) [not null, unique]
  provider_payment_id varchar(160) [unique]
  status payment_status [not null, default: 'PENDING']
  currency char(3) [not null]
  amount_minor bigint [not null]
  original_amount_minor bigint [not null]
  discount_amount_minor bigint [not null, default: 0]
  discount_campaign_id uuid [ref: > discount_campaigns.id]
  idempotency_key varchar(128) [not null, unique]
  paid_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, status, created_at) [name: 'idx_payments_org_status_created']
    (provider, provider_payment_id) [name: 'idx_payments_provider_id']
  }
}

Table payment_sessions {
  id uuid [pk]
  payment_id uuid [not null, ref: > payments.id]
  provider varchar(40) [not null, default: 'XENDIT']
  provider_session_id varchar(160) [not null]
  provider_payment_request_id varchar(160)
  provider_payment_id varchar(160)
  reference_id varchar(160) [not null]
  session_type varchar(24) [not null, default: 'PAY']
  mode varchar(32) [not null, default: 'PAYMENT_LINK']
  capture_method varchar(24) [not null, default: 'AUTOMATIC']
  country char(2) [not null, default: 'ID']
  currency char(3) [not null]
  amount_minor bigint [not null]
  status payment_session_status [not null, default: 'CREATED']
  payment_link_url text
  success_return_url text [not null]
  cancel_return_url text [not null]
  expires_at timestamptz
  provider_updated_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, provider_session_id) [unique, name: 'uq_payment_session_provider_id']
    (provider, reference_id) [unique, name: 'uq_payment_session_reference']
    (payment_id, created_at) [name: 'idx_payment_sessions_payment']
    (status, expires_at) [name: 'idx_payment_sessions_status_expiry']
  }
}

Table payment_webhook_events {
  id uuid [pk]
  provider varchar(40) [not null]
  provider_event_id varchar(160) [not null]
  event_type varchar(80) [not null]
  deduplication_key varchar(255) [not null]
  provider_resource_id varchar(160)
  provider_status varchar(64)
  provider_updated_at timestamptz
  signature_valid boolean [not null]
  payload_hash varchar(128) [not null]
  received_at timestamptz [not null]
  processed_at timestamptz
  processing_error_code varchar(80)

  indexes {
    (provider, provider_event_id) [name: 'idx_payment_webhook_provider_event']
    (provider, deduplication_key) [unique, name: 'uq_payment_webhook_dedupe']
    (provider, provider_resource_id, received_at) [name: 'idx_payment_webhook_resource']
    (processed_at, received_at) [name: 'idx_payment_webhook_processing']
  }
}

Table refunds {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  payment_id uuid [not null, ref: > payments.id]
  requested_by_user_id uuid [not null, ref: > users.id]
  reviewed_by_admin_id uuid [ref: > users.id]
  status refund_status [not null, default: 'SUBMITTED']
  reason_category varchar(80) [not null]
  reason_text text [not null]
  evidence_file_id uuid
  requested_amount_minor bigint [not null]
  approved_amount_minor bigint
  provider_refund_id varchar(160) [unique]
  provider_status varchar(40)
  provider_failure_code varchar(80)
  provider_updated_at timestamptz
  access_adjusted_at timestamptz
  submitted_at timestamptz [not null]
  resolved_at timestamptz
  updated_at timestamptz [not null]

  indexes {
    (organization_id, status, submitted_at) [name: 'idx_refunds_org_status']
    (payment_id, status) [name: 'idx_refunds_payment_status']
  }
}

Table payment_disputes {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  payment_id uuid [not null, ref: > payments.id]
  provider varchar(40) [not null, default: 'XENDIT']
  provider_dispute_id varchar(160) [not null]
  reference_id varchar(160)
  status payment_dispute_status [not null]
  status_reason varchar(120)
  channel_code varchar(80)
  currency char(3) [not null]
  amount_minor bigint [not null]
  due_at timestamptz
  action_required_at timestamptz
  provider_updated_at timestamptz [not null]
  resolved_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, provider_dispute_id) [unique, name: 'uq_payment_dispute_provider_id']
    (organization_id, status, due_at) [name: 'idx_payment_disputes_org_status_due']
    (payment_id, created_at) [name: 'idx_payment_disputes_payment']
  }
}

Table payment_dispute_evidences {
  id uuid [pk]
  dispute_id uuid [not null, ref: > payment_disputes.id]
  file_id uuid [ref: > files.id]
  evidence_type varchar(80) [not null]
  text_value text
  provider_evidence_id varchar(160)
  submitted_by_admin_id uuid [ref: > users.id]
  submitted_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (dispute_id, created_at) [name: 'idx_dispute_evidences_dispute']
  }
}

Table refund_approvals {
  id uuid [pk]
  refund_id uuid [not null, ref: > refunds.id]
  administrator_id uuid [not null, ref: > users.id]
  decision varchar(24) [not null]
  reason text
  decided_at timestamptz [not null]

  indexes {
    (refund_id, administrator_id) [unique, name: 'uq_refund_admin_approval']
  }
}

Table custom_plan_requests {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  submitted_by_user_id uuid [not null, ref: > users.id]
  ticket_number varchar(40) [not null, unique]
  status custom_request_status [not null, default: 'SUBMITTED']
  company_name varchar(255) [not null]
  pic_name varchar(200) [not null]
  pic_email varchar(320) [not null]
  phone varchar(40) [not null]
  entity_count int [not null]
  estimated_users int [not null]
  estimated_documents_per_year int [not null]
  needs_multi_entity boolean [not null, default: false]
  needs_sso boolean [not null, default: false]
  requested_data_region varchar(64)
  special_support text
  additional_notes text
  contact_consent_at timestamptz [not null]
  submitted_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (organization_id, status, submitted_at) [name: 'idx_custom_requests_org_status']
    (status, submitted_at) [name: 'idx_custom_requests_admin_queue']
  }
}

Table custom_plan_request_history {
  id uuid [pk]
  request_id uuid [not null, ref: > custom_plan_requests.id]
  from_status custom_request_status
  to_status custom_request_status [not null]
  changed_by_user_id uuid [not null, ref: > users.id]
  note text
  created_at timestamptz [not null]

  indexes {
    (request_id, created_at) [name: 'idx_custom_request_history']
  }
}

Table quotations {
  id uuid [pk]
  custom_plan_request_id uuid [not null, ref: > custom_plan_requests.id]
  quotation_number varchar(40) [not null, unique]
  status quotation_status [not null, default: 'DRAFT']
  currency char(3) [not null]
  total_amount_minor bigint [not null]
  original_amount_minor bigint [not null]
  discount_amount_minor bigint [not null, default: 0]
  discount_campaign_id uuid [ref: > discount_campaigns.id]
  valid_until timestamptz [not null]
  document_quota int [not null]
  seat_quota int [not null]
  subscription_months int [not null]
  terms text
  created_by_admin_id uuid [not null, ref: > users.id]
  accepted_by_user_id uuid [ref: > users.id]
  accepted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table quotation_items {
  id uuid [pk]
  quotation_id uuid [not null, ref: > quotations.id]
  item_code varchar(80) [not null]
  description varchar(255) [not null]
  quantity int [not null]
  unit_amount_minor bigint [not null]
  total_amount_minor bigint [not null]
  sort_order int [not null]

  indexes {
    (quotation_id, sort_order) [unique, name: 'uq_quotation_item_order']
  }
}

Table withdrawals {
  id uuid [pk]
  requested_by_admin_id uuid [not null, ref: > users.id]
  approved_by_admin_id uuid [ref: > users.id]
  provider_payout_id varchar(160) [unique]
  provider_reference_id varchar(160) [unique]
  status varchar(32) [not null]
  currency char(3) [not null]
  amount_minor bigint [not null]
  idempotency_key varchar(128) [not null, unique]
  destination_account_hash varchar(128)
  provider_failure_code varchar(80)
  estimated_arrival_at timestamptz
  requested_at timestamptz [not null]
  processed_at timestamptz
}

Table files {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  uploaded_by_user_id uuid [not null, ref: > users.id]
  purpose varchar(80) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(120) [not null]
  size_bytes bigint [not null]
  chunk_count int [not null, default: 0]
  checksum_sha256 varchar(64) [not null]
  content_status file_content_status [not null, default: 'UPLOADING']
  scan_status file_scan_status [not null, default: 'PENDING']
  content_completed_at timestamptz
  scanned_at timestamptz
  quarantined_at timestamptz
  retention_until timestamptz
  created_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    (organization_id, purpose, created_at) [name: 'idx_files_org_purpose']
    (scan_status, created_at) [name: 'idx_files_scan_queue']
  }
}

Table file_blob_chunks {
  // Konten maksimal 1 MiB per baris; maksimum 50 chunk/file ditegakkan migration dan service.
  file_id uuid [not null, ref: > files.id]
  chunk_index int [not null]
  content bytea [not null]
  size_bytes int [not null]
  created_at timestamptz [not null]

  indexes {
    (file_id, chunk_index) [pk, name: 'pk_file_blob_chunks']
    (file_id) [name: 'idx_file_blob_chunks_file']
  }
}

Table local_files {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  created_by_user_id uuid [not null, ref: > users.id]
  owner_shared boolean [not null, default: false, note: 'Hanya bermakna bagi dokumen buatan Karyawan; User Induk selalu mengakses dokumen buatannya']
  taken_over_by_user_id uuid [ref: > users.id, note: 'User Induk penerima akses setelah membership pembuat dicabut']
  taken_over_at timestamptz
  title varchar(255) [not null]
  tax_year int [not null]
  identity_hash varchar(128) [not null]
  version int [not null, default: 1]
  status local_file_status [not null, default: 'DRAFT']
  characteristic varchar(120)
  selected_tp_method varchar(40)
  last_edited_by_user_id uuid [not null, ref: > users.id]
  last_edited_at timestamptz [not null]
  duplicated_from_local_file_id uuid [ref: > local_files.id]
  duplicated_by_user_id uuid [ref: > users.id]
  ready_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz

  indexes {
    (organization_id, identity_hash) [unique, name: 'uq_local_file_identity']
    (organization_id, tax_year, created_at) [name: 'idx_local_files_org_tax_year']
    (organization_id, status, updated_at) [name: 'idx_local_files_org_status']
    (created_by_user_id, updated_at) [name: 'idx_local_files_creator_updated']
  }
}

